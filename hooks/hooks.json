{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${HOME}/.claude/fable-mode.txt\"; cat \"${CLAUDE_PLUGIN_ROOT}/hooks/payloads/session.txt\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${HOME}/.claude/fable-mode.txt\"; cat \"${CLAUDE_PLUGIN_ROOT}/hooks/payloads/guard.txt\""
          }
        ]
      }
    ]
  }
}
